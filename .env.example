# Server-side only. Copy to .env.local for local testing; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/mokra?sslmode=require
# Website sessions use database-issued random tokens; SESSION_SECRET is not required.

# Mokra AI (Groq). Never commit the real key. Set only on your server host.
GROQ_API_KEY=YOUR_SECRET_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
